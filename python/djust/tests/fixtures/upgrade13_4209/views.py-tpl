"""1.3 views for the djust_exposure_inventory --fix tests (#4209).

CartView is the 2.0 upgrade guide's section 1, step 1 view as written. The
file is a .py-tpl so nothing imports it as part of the test package (2.0 refuses
its 1.3 statements); the tests copy it to a temporary .py and import that.
"""

from django.utils.html import format_html

from djust import LiveView
from djust.decorators import event_handler, state


class CartView(LiveView):
    exposure_policy = "legacy"  # the 1.3 default; on 1.3 the line can be left out
    template = """<div dj-root>
        <p>{{ items|length }} items, coupon {{ coupon }}, page {{ page }}</p>
        <button dj-click="add" data-sku="A1">Add</button>
    </div>"""

    def mount(self, request, **kwargs):
        self.items = []
        self.coupon = "none"
        self.page = 1
        self._audit_note = "internal"

    @event_handler()
    def add(self, sku: str = "", **kwargs):
        self.items.append(sku)

    @event_handler()
    def apply_coupon(self, value: str = "", **kwargs):
        self.coupon = value


class AppView(LiveView):
    exposure_policy = "legacy"


class SearchView(AppView):
    template_name = "upgrade13_4209/search.html"

    def mount(self, request, **kwargs):
        self.query = "none"
        self.selected = 0

    @event_handler()
    def search(self, value="", **kwargs):
        self.query = value

    @event_handler()
    def open_item(self, item_id=0, label="café", count=1, **kwargs):
        self.selected = int(item_id)
        self.last_field = kwargs.get("_target")
        self.flash = "opened %s" % label


class ReportView(LiveView):
    exposure_policy = "legacy"
    template_name = "upgrade13_4209/report.html"

    def mount(self, request, **kwargs):
        self.rows = []

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        context["title"] = "Report"
        return context


class ChipView(LiveView):
    exposure_policy = "legacy"
    template = """<div dj-root><p>chips</p></div>"""

    def render_chip(self):
        return format_html('<button dj-click="pick" data-item-id="{}">x</button>', 1)


class ModernView(LiveView):
    exposure_policy = "explicit"
    template = """<div dj-root>
        <p>{{ count }}</p>
        <button dj-click="bump" dj-value-step="2">Bump</button>
    </div>"""

    count = state(0)

    @event_handler(parameter_policy="strict")
    def bump(self, step: int = 1):
        self.count += step
